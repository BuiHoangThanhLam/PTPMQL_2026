@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Xóa Sinh viên";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="main-content-box border-top border-danger border-4">
            <div class="text-center mb-4">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                <h2 class="text-danger mt-2">Xóa Sinh Viên</h2>
                <p class="text-muted">Bạn có chắc chắn muốn xóa sinh viên này không? Hành động này không thể hoàn tác.</p>
            </div>
            <hr class="mb-4" />
            
            <div class="bg-light p-3 rounded mb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.MaSV)</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.MaSV)</dd>
                    
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.HoTen)</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.HoTen)</dd>
                    
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.SDT)</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.SDT)</dd>
                    
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.DiaChi)</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.DiaChi)</dd>
                    
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.NgaySinh)</dt>
                    <dd class="col-sm-8 fw-bold text-dark">
                        @(Model?.NgaySinh != default ? Model?.NgaySinh.ToString("dd/MM/yyyy") : "")
                    </dd>
                    
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.GioiTinh)</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.GioiTinh)</dd>
                </dl>
            </div>
            
            <form asp-action="Delete" class="text-center">
                <input type="hidden" asp-for="ID" />
                <button type="submit" class="btn btn-danger btn-lg px-5">Xác nhận Xóa</button>
            </form>
            
            <div class="text-center mt-4">
                <a asp-action="Index" class="back-link">&larr; Hủy và Quay lại</a>
            </div>
        </div>
    </div>
</div>