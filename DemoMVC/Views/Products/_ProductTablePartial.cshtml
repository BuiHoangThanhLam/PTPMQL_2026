@model DemoMVC.Models.ViewModels.ProductTableViewModel

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>SKU</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th class="text-end">Giá bán</th>
                <th class="text-end">Tồn kho</th>
                <th class="text-center" style="width: 210px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-secondary py-5">
                        Không có sản phẩm phù hợp.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var product in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@product.Sku</td>
                        <td>@product.Name</td>
                        <td>@(product.Category?.Name ?? "-")</td>
                        <td class="text-end">@product.SellingPrice.ToString("N0") ₫</td>
                        <td class="text-end">
                            @product.StockQuantity @product.Unit
                        </td>
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    data-action="details"
                                    data-url="@Url.Action("Details", "Products", new { id = product.Id })">
                                Chi tiết
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-action="edit"
                                    data-url="@Url.Action("Edit", "Products", new { id = product.Id })">
                                Sửa
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    data-action="delete"
                                    data-url="@Url.Action("Delete", "Products", new { id = product.Id })">
                                Xóa
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Phân trang sản phẩm">
        <ul class="pagination justify-content-end mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="#" data-page="@(Model.Page - 1)">Trước</a>
            </li>
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                    <a class="page-link" href="#" data-page="@pageNumber">@pageNumber</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="#" data-page="@(Model.Page + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}
