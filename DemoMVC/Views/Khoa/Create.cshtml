@model DemoMVC.Models.Khoa

@{
    ViewData["Title"] = "Thêm Khoa";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="main-content-box border-top border-success border-4">
            <h2 class="text-success mb-4 text-center">Thêm Mới Khoa</h2>
            <hr class="mb-4" />
            
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="TenKhoa" class="control-label"></label>
                    <input asp-for="TenKhoa" class="form-control" placeholder="VD: Công nghệ thông tin..." />
                    <span asp-validation-for="TenKhoa" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-4">
                    <label asp-for="MaNganh" class="control-label"></label>
                    <input asp-for="MaNganh" class="form-control" placeholder="VD: 05..." />
                    <span asp-validation-for="MaNganh" class="text-danger"></span>
                </div>
                
                <div class="form-group d-grid">
                    <input type="submit" value="Lưu Dữ Liệu" class="btn btn-success btn-lg" />
                </div>
            </form>
            
            <div class="text-center mt-4">
                <a asp-action="Index" class="back-link">&larr; Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>